{
    "position": "top",
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "spacing": 5,

    "modules-left": [
	    "custom/menu",
	    "clock"
    ],
    "modules-center": [
	    "hyprland/workspaces",
	    "tray"
    ],
    "modules-right": [
	    "group/hardware",
	    "group/connectivity",
	    "custom/notification"
    ],

    "group/hardware": {
	    "orientation": "horizontal",
	    "drawer": { // Optionnel : cache les détails et les montre au survol
		    "transition-duration": 500,
		    "children-class": "not-memory",
		    "transition-left-to-right": false
	    },
	    "modules": [
		    "cpu",
		    "memory",
		    "temperature"
	    ]
    },
    "cpu": {
	    "format": "󰘚 {usage}%",
	    "on-click": "kitty -e btop"
    },
    "memory": {
	    "format": "󰍛 {used}G",
	    "tooltip-format": "RAM: {used}GB / {total}GB"
    },
    "temperature": {
	    "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
	    "format": "󰔐 {temperatureC}°C",
	    "critical-threshold": 75,
	    "format-critical": "󰸁 {temperatureC}°C",
	    "interval": 5
    },
    "group/connectivity": {
	    "orientation": "horizontal",
	    "modules": [
		    "pulseaudio",
		    "network",
		    "battery"
	    ]
    },
        "clock": {
	    "format": "{:%H:%M}",
	    "format-alt": "󰃭 {:%d·%m·%y}", // Date complète au clic droit ou clic alterné
	    "tooltip-format": "<tt>{calendar}</tt>",
	    "calendar": {
		    "mode": "month",
		    "on-scroll": 1,
		    "format": {
			    "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
		    }
	    }
    },
    "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "on-click": "activate", 
    "format": "{icon}",
    "persistent-workspaces": {
        "*": 5 
    },
    "format-icons": {
        "active": "●",      // Bureau actuel (rempli)
        "default": "",     // Bureau inactif MAIS occupé par des fenêtres (cercle avec point)
        "empty": "○",       // Bureau totalement vide
        "urgent": "",      // Alerte
        "special": "󰠱"      // Icône pour le scratchpad (bureau spécial Hyprland)
    }
},
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "pulseaudio": {
	    "format": "{icon} {volume}%",
	    "format-muted": "󰝟",
	    "format-icons": {
		    "headphone": "",
		    "hands-free": "",
		    "headset": "",
		    "phone": "",
		    "portable": "",
		    "car": "",
		    "default": ["", "", ""]
	    },
	    "tooltip-format": "{volume}% - {desc}",
	    "on-click": "pavucontrol"
    },
    "network": {
	    "interval": 3,
	    "format-wifi": "",
	    "format-ethernet": "󰊗",
	    "tooltip-format-wifi": "{essid} — {signalStrength}% — ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
	    "tooltip-format-ethernet": "{ifname} — {ipaddr}",
	    "on-click": "networkmanager_dmenu"
    },
    "battery": {
	    "states": {
		    "warning": 30,
		    "critical": 15
	    },
	    "format": "{icon} {capacity}%",
	    "format-charging": "󱐋 {icon} {capacity}%", // Petit éclair quand tu branches
	    "format-plugged": " {icon} {capacity}%",   // Icône prise quand c'est plein et branché
	    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	    "tooltip-format": "{capacity}% - {timeTo}", // Le % reste visible au survol de la souris
	    "interval": 5
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/menu":{
    "format": "󰮯",
    "tooltip": false,
    "on-click": "rofi -show drun"
    }
}
