@import "../../.cache/wal/colors-waybar.css";

@import ;



* {
border: none;
border-radius: 0;
font-family: "Adwaita Sans", "JetBrainsMono Nerd Font Propo", sans-serif;
font-weight: bold;
min-height: 0;
padding: 0;
margin: 0;
}

window#waybar {
background: transparent;
}

tooltip {
background: alpha(@bg0, 0.4);
border: 1px solid alpha(@bg3, 0.3);
border-radius: 12px;
}

tooltip label {
color: @fg;
padding: 6px;
}

#workspaces {
background-color: alpha(@bg0, 0.3);
padding: 5px 3px;
margin: 0 0 0 12px;
border-radius: 18px;
border: 1px solid alpha(@bg3, 0.3);
color: @fg;
}

#workspaces button {
padding: 0 6px;
margin: 0 3px;
border-radius: 50px;
color: @fg;
background: alpha(@bg3, 0.5);
transition: all 0.2s ease-in-out;
}

#workspaces button.active {
background-color: alpha(@blue, 0.7);
color: @bg0;
min-width: 50px;
transition: all 0.2s ease-in-out;
font-size: 13px;
}

#workspaces button:hover {
background-color: alpha(@purple, 0.7);
color: @bg0;
border-radius: 16px;
min-width: 50px;
}

#workspaces button.urgent {
background-color: alpha(@red, 0.7);
color: @bg0;
border-radius: 16px;
min-width: 50px;
transition: all 0.2s ease-in-out;
}

#battery,
#pulseaudio,
#network,
#clock,
#custom-notification {
background-color: alpha(@bg0, 0.3);
padding: 0 15px;
margin: 0 0 0 12px;
border-radius: 50px;
border: 1px solid alpha(@bg3, 0.3);
}

#clock { color: @blue; }
#custom-notification { color: @fg; }
#pulseaudio { color: @yellow; }
#network { color: @purple; }
#battery { color: @green; }
